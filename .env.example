DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Azure AD / NTU SSO
# Create these values from the NTU Azure App Registration.
APP_REG_CLIENT_ID=your-azure-app-client-id
APP_REG_CLIENT_SECRET=your-azure-app-client-secret
AUTHORITY=https://login.microsoftonline.com/<ntu-tenant-id>

# Local development URLs
# This redirect URI must also be registered in the Azure App Registration.
AUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
FRONTEND_URL=http://127.0.0.1:5173

# Local app session signing secret.
# Use a long random value locally. Do not commit your real secret.
SESSION_SECRET=change-me-to-a-long-random-local-secret
