  {
    "code": "CE3102",
    "title": "SIGNALS, SYSTEMS & TRANSFORMS",
    "no_of_credits": "3.0 AU",
    "grading_type": null,
    "prerequisites": [
      "CE1104"
    ],
    "mutually_exclusive": [
