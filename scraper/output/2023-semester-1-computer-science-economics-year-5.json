  {
    "code": "CZ4153",
    "title": "BLOCKCHAIN TECHNOLOGY",
    "no_of_credits": "3.0 AU",
    "grading_type": null,
    "prerequisites": [
      "CE1007 & CE2001 & MH1812 OR",
      "CZ1007 & CZ2001 & MH1812 OR",
      "CZ1107 & CZ2101 & MH1812"
    ],
